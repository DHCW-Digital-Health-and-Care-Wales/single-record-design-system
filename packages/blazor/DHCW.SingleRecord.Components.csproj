<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The PREVIEW gallery library, not the published package.

    Two projects live under packages/blazor and they do different jobs:

      DHCW.SingleRecord.Components.csproj   this file — SrButton and Gallery,
                                            for the Visual Studio preview host
                                            described in docs/engineering/
                                            visual-studio-preview.md
      nuget/DHCW.SingleRecord.Blazor.csproj GENERATED — the token and style
                                            layer that actually ships

    They are separate because they answer different questions. The published
    package is a stylesheet layer with no components (see its README for why);
    this one exists so there is something to look at in a browser.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DHCW.SingleRecord.Components</RootNamespace>
    <StaticWebAssetBasePath>_content/DHCW.SingleRecord.Components</StaticWebAssetBasePath>
    <!-- Never packed. The shipping package is nuget/DHCW.SingleRecord.Blazor. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
  </ItemGroup>

  <!--
    Serves the SAME generated CSS the published package ships, by reference
    rather than by copy. There used to be a hand-maintained mirror under
    packages/blazor/wwwroot/, refreshed by commands written in this file as a
    comment that nothing ran — so it drifted, and it carried three files where
    a web consumer got twenty-one components.

    Regenerate with `npm run build:blazor`.
  -->
  <ItemGroup>
    <Content Include="nuget\wwwroot\css\**\*" LinkBase="wwwroot\css" />
  </ItemGroup>

</Project>

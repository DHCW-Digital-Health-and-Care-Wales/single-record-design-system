<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The packaged dictionaries, compiled for plain net10.0 so they can be
    constructed off-device. Same assembly name as the real library, so a
    consumer's assembly=DHCW.SingleRecord.Maui resolves. See smoke/README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DHCW.SingleRecord.Maui</AssemblyName>
    <RootNamespace>DHCW.SingleRecord.Maui</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
    <MauiXamlInflator>XamlC</MauiXamlInflator>
    <NoWarn>$(NoWarn);MAUI1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
  <ItemGroup>
    <MauiXaml Include="../../nuget/*.xaml" Link="%(Filename)%(Extension)" />
    <Compile Include="../../nuget/*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

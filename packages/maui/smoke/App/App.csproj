<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WCP mobile prototype's XAML and C#, without Platforms/, for net10.0. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WcpPrototype</AssemblyName>
    <RootNamespace>WcpPrototype</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
    <MauiXamlInflator>XamlC</MauiXamlInflator>
    <NoWarn>$(NoWarn);MAUI1001</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <Proto>../../../../products/wcp-mobile/prototype</Proto>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../Lib/Lib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <MauiXaml Include="$(Proto)/**/*.xaml" Exclude="$(Proto)/bin/**;$(Proto)/obj/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(Proto)/**/*.cs" Exclude="$(Proto)/Platforms/**;$(Proto)/bin/**;$(Proto)/obj/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

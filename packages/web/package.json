{
  "name": "@dhcw/sr-web",
  "version": "0.1.1",
  "description": "Canonical HTML/CSS components for the DHCW Single Record Design System. Framework-agnostic reference implementation following the GOV.UK Frontend model.",
  "license": "MIT",
  "type": "module",
  "main": "dist/single-record.css",
  "files": [
    "dist/",
    "src/",
    "!src/**/*.stories.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Chuk-DCHW/dhcw-single-record-design-system.git",
    "directory": "packages/web"
  },
  "bugs": "https://github.com/Chuk-DCHW/dhcw-single-record-design-system/issues",
  "dependencies": {
    "@dhcw/sr-tokens": "^0.1.1",
    "@dhcw/sr-icons": "^0.1.1"
  },
  "style": "dist/single-record.css",
  "exports": {
    ".": "./dist/single-record.css",
    "./foundations": "./dist/foundations.css",
    "./dark": "./dist/single-record-dark.css",
    "./source": "./src/index.css",
    "./icons.js": "./dist/icons.js",
    "./sprite.svg": "./dist/sprite.svg",
    "./components/*": "./dist/components/*",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./logos": "./dist/logos/",
    "./logos/*": "./dist/logos/*"
  },
  "scripts": {
    "build": "node build.mjs"
  }
}

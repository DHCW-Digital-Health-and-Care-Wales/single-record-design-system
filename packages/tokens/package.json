{
  "name": "@dhcw/sr-tokens",
  "version": "0.2.0",
  "description": "DHCW Single Record Design System \u2014 design tokens. Outputs CSS custom properties, SCSS variables, and XAML ResourceDictionary from the canonical JSON token source.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "style-dictionary": "^4.0.0"
  },
  "files": [
    "build/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Chuk-DCHW/dhcw-single-record-design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/Chuk-DCHW/dhcw-single-record-design-system/issues",
  "exports": {
    ".": "./build/css/tokens.css",
    "./dark": "./build/css/tokens-dark.css",
    "./fonts": "./build/css/fonts.css",
    "./typography": "./build/css/typography.css",
    "./flat.json": "./build/json/tokens-flat.json",
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  }
}

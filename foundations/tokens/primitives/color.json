{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "DHCW Single Record Design System — Primitive colour tokens (Tier 1). Raw palette values. Never reference these directly in components — use semantic tokens.",
  "color": {
    "blue": {
      "$description": "NHS Wales Blue — primary brand",
      "900": { "$type": "color", "$value": "#1E3050" },
      "800": { "$type": "color", "$value": "#325083", "$description": "Brand primary (light mode)" },
      "700": { "$type": "color", "$value": "#3D6199" },
      "600": { "$type": "color", "$value": "#4C72AE" },
      "500": { "$type": "color", "$value": "#5C6991" },
      "400": { "$type": "color", "$value": "#828DAC", "$description": "Interactive/Disabled — semantic anchor" },
      "300": { "$type": "color", "$value": "#AAB1C6" },
      "200": { "$type": "color", "$value": "#D4D8E2" },
      "100": { "$type": "color", "$value": "#ECEEF3" },
      "50":  { "$type": "color", "$value": "#F4F5F8", "$description": "Default page background (light mode)" }
    },
    "cyan": {
      "$description": "DHCW Blue — secondary/accent. Cyan/700 is the focus-ring colour (DDR-006).",
      "900": { "$type": "color", "$value": "#0A6A84" },
      "850": { "$type": "color", "$value": "#0C7B99", "$description": "Surface/Small Cards in dark mode" },
      "800": { "$type": "color", "$value": "#0D8BAD" },
      "700": { "$type": "color", "$value": "#12A3C9", "$description": "Brand secondary + Border/Focus (both modes)" },
      "600": { "$type": "color", "$value": "#71ACCD" },
      "500": { "$type": "color", "$value": "#8DC0DA" },
      "400": { "$type": "color", "$value": "#AFD4E5", "$description": "Interactive/Link in dark mode" },
      "300": { "$type": "color", "$value": "#D6EAF2" },
      "100": { "$type": "color", "$value": "#EBF5FA" },
      "50":  { "$type": "color", "$value": "#F4FAFC" }
    },
    "navy": {
      "$description": "DHCW Navy",
      "900": { "$type": "color", "$value": "#1B294A" },
      "700": { "$type": "color", "$value": "#464C64" },
      "500": { "$type": "color", "$value": "#707488", "$description": "Text/Disabled in light mode" },
      "300": { "$type": "color", "$value": "#9EA1AF", "$description": "Border/Disabled, Text/Disabled (dark)" },
      "100": { "$type": "color", "$value": "#CDCFD6" }
    },
    "red": {
      "$description": "Status — error/critical",
      "900": { "$type": "color", "$value": "#5F110A" },
      "800": { "$type": "color", "$value": "#8B190F" },
      "700": { "$type": "color", "$value": "#B32014" },
      "600": { "$type": "color", "$value": "#D5281B" },
      "500": { "$type": "color", "$value": "#E03A31" },
      "400": { "$type": "color", "$value": "#EC5E56" },
      "300": { "$type": "color", "$value": "#F48B85" },
      "200": { "$type": "color", "$value": "#F9B5B1" },
      "100": { "$type": "color", "$value": "#FCDBD9" },
      "50":  { "$type": "color", "$value": "#FEF3F2" }
    },
    "green": {
      "$description": "Status — success",
      "900": { "$type": "color", "$value": "#003319" },
      "800": { "$type": "color", "$value": "#004D24" },
      "700": { "$type": "color", "$value": "#006630" },
      "600": { "$type": "color", "$value": "#007F3B" },
      "500": { "$type": "color", "$value": "#1FA66D" },
      "400": { "$type": "color", "$value": "#4AB88B" },
      "300": { "$type": "color", "$value": "#7BCAAA" },
      "200": { "$type": "color", "$value": "#AEDDC9" },
      "100": { "$type": "color", "$value": "#D9EFE5" },
      "50":  { "$type": "color", "$value": "#F0FAF4" }
    },
    "yellow": {
      "$description": "Status — warning",
      "900": { "$type": "color", "$value": "#4A3000", "$description": "Darkest warning text on light surfaces" },
      "800": { "$type": "color", "$value": "#6B4400" },
      "700": { "$type": "color", "$value": "#8A5A00", "$description": "Warning banner/pill text colour" },
      "600": { "$type": "color", "$value": "#B47800" },
      "500": { "$type": "color", "$value": "#F8CA4D" },
      "400": { "$type": "color", "$value": "#FACE62" },
      "300": { "$type": "color", "$value": "#FBD97F" },
      "200": { "$type": "color", "$value": "#FDE8AB" },
      "100": { "$type": "color", "$value": "#FDF3D7" },
      "50":  { "$type": "color", "$value": "#FFFAEB" }
    },
    "info-blue": {
      "$description": "Status — informational. info-blue.700 is the link/info semantic value in light mode. info-blue.600/800 anchor dark-mode Interactive/Primary and its hover step.",
      "default": { "$type": "color", "$value": "#005AA8", "$description": "Alias for 700 — retained for backward compatibility" },
      "900": { "$type": "color", "$value": "#002E5C" },
      "800": { "$type": "color", "$value": "#004483", "$description": "Interactive/Primary Hover (dark mode)" },
      "700": { "$type": "color", "$value": "#005AA8", "$description": "Interactive/Link (light), Status/Info" },
      "600": { "$type": "color", "$value": "#0D62A3", "$description": "Interactive/Primary (dark mode)" },
      "500": { "$type": "color", "$value": "#267AB8" },
      "400": { "$type": "color", "$value": "#4E95CA" },
      "300": { "$type": "color", "$value": "#7EB0D9" },
      "200": { "$type": "color", "$value": "#AECCE8" },
      "100": { "$type": "color", "$value": "#D6E8F5" },
      "50":  { "$type": "color", "$value": "#EEF5FC" }
    },
    "focus-yellow": {
      "$description": "DEPRECATED — superseded by cyan.700 for focus rings (DDR-006). Primitive retained for any legacy reference; do not use in new work.",
      "default": { "$type": "color", "$value": "#FFEB3B" }
    },
    "grey": {
      "$description": "Neutral/UI palette. Full 50–900 ramp anchored to the NHS neutral greys. Existing stops (900/600/200/100) unchanged; 800/700/500/400/300/50 added 2026-07-09 (additive, no rebinding). Contrast on white noted for guidance.",
      "900": { "$type": "color", "$value": "#212B32", "$description": "Primary text (14.4:1 on white)" },
      "800": { "$type": "color", "$value": "#2C3A44", "$description": "Strong text on tinted surfaces (11.7:1)" },
      "700": { "$type": "color", "$value": "#3B4E5B", "$description": "Headings on grey surfaces (8.7:1)" },
      "600": { "$type": "color", "$value": "#4C6272", "$description": "Secondary/hint text (6.4:1 — AA). NHS grey-1. Accessible placeholder-text value." },
      "500": { "$type": "color", "$value": "#768692", "$description": "Muted/placeholder fill, disabled text, icons, strong borders (3.75:1 — passes 3:1 non-text; below 4.5:1 for body text). NHS grey-2." },
      "400": { "$type": "color", "$value": "#AEB7BD", "$description": "Borders, dividers — non-text (2.0:1). NHS grey-3." },
      "300": { "$type": "color", "$value": "#C6CDD1", "$description": "Subtle dividers, disabled fills (1.6:1)" },
      "200": { "$type": "color", "$value": "#D8DDE0", "$description": "Default borders. NHS grey-4." },
      "100": { "$type": "color", "$value": "#F0F4F5", "$description": "Grey background. NHS grey-5." },
      "50":  { "$type": "color", "$value": "#F7FAFA", "$description": "Lightest neutral wash" }
    },
    "white": {
      "default": { "$type": "color", "$value": "#FFFFFF" }
    }
  }
}

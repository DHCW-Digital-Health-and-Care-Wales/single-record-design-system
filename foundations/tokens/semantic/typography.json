{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "DHCW Single Record Design System — Semantic typography tokens (Tier 2). All values reference primitive tokens via {path} syntax. Prefix: sr (Single Record). Desktop and mobile variants are separated; apply via breakpoints defined in tokens/breakpoints.json. Scale governed by DDR-005.",

  "sr": {
    "typography": {

      "heading-xl": {
        "$description": "Extra-large heading. Page-level titles and hero text.",
        "desktop": {
          "$type": "typography",
          "$description": "heading-xl desktop (≥1024px): 36/44 bold",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.36}",
            "lineHeight":    "{font.line-height.44}",
            "fontWeight":    "{font.weight.bold}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "heading-xl mobile (<768px): 28/36 bold",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.28}",
            "lineHeight":    "{font.line-height.36}",
            "fontWeight":    "{font.weight.bold}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        }
      },

      "heading-l": {
        "$description": "Large heading. Section titles and major content groupings.",
        "desktop": {
          "$type": "typography",
          "$description": "heading-l desktop (≥1024px): 28/36 bold",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.28}",
            "lineHeight":    "{font.line-height.36}",
            "fontWeight":    "{font.weight.bold}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "heading-l mobile (<768px): 24/32 bold",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.24}",
            "lineHeight":    "{font.line-height.32}",
            "fontWeight":    "{font.weight.bold}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        }
      },

      "heading-m": {
        "$description": "Medium heading. Sub-section titles, card headings, panel headers.",
        "desktop": {
          "$type": "typography",
          "$description": "heading-m desktop (≥1024px): 24/32 bold",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.24}",
            "lineHeight":    "{font.line-height.32}",
            "fontWeight":    "{font.weight.bold}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "heading-m mobile (<768px): 20/28 bold",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.20}",
            "lineHeight":    "{font.line-height.28}",
            "fontWeight":    "{font.weight.bold}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        }
      },

      "heading-s": {
        "$description": "Small heading. List group labels, sidebar headings, modal titles.",
        "desktop": {
          "$type": "typography",
          "$description": "heading-s desktop (≥1024px): 20/28 bold",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.20}",
            "lineHeight":    "{font.line-height.28}",
            "fontWeight":    "{font.weight.bold}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "heading-s mobile (<768px): 18/24 bold",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.18}",
            "lineHeight":    "{font.line-height.24}",
            "fontWeight":    "{font.weight.bold}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        }
      },

      "heading-xs": {
        "$description": "Extra-small heading. Inline section labels, tight UI contexts.",
        "desktop": {
          "$type": "typography",
          "$description": "heading-xs desktop (≥1024px): 16/24 medium",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.16}",
            "lineHeight":    "{font.line-height.24}",
            "fontWeight":    "{font.weight.medium}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "heading-xs mobile (<768px): 16/24 medium",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.16}",
            "lineHeight":    "{font.line-height.24}",
            "fontWeight":    "{font.weight.medium}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        }
      },

      "body-m": {
        "$description": "Medium body text. Default prose, clinical notes, descriptions. 16px — meets NHS and WCAG minimum body text guidance.",
        "desktop": {
          "$type": "typography",
          "$description": "body-m: 16/24 regular",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.16}",
            "lineHeight":    "{font.line-height.24}",
            "fontWeight":    "{font.weight.regular}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "body-m: 16/24 regular",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.16}",
            "lineHeight":    "{font.line-height.24}",
            "fontWeight":    "{font.weight.regular}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        }
      },

      "body-s": {
        "$description": "Small body text. Supporting content, secondary prose, help text. 14px — do not use for primary clinical content.",
        "desktop": {
          "$type": "typography",
          "$description": "body-s: 14/20 regular",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.14}",
            "lineHeight":    "{font.line-height.20}",
            "fontWeight":    "{font.weight.regular}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "body-s: 14/20 regular",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.14}",
            "lineHeight":    "{font.line-height.20}",
            "fontWeight":    "{font.weight.regular}",
            "letterSpacing": "{font.letter-spacing.default}"
          }
        }
      },

      "label": {
        "$description": "UI labels. Form field labels, navigation items, button text, data table column headers.",
        "desktop": {
          "$type": "typography",
          "$description": "label: 14/20 medium, wide tracking",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.14}",
            "lineHeight":    "{font.line-height.20}",
            "fontWeight":    "{font.weight.medium}",
            "letterSpacing": "{font.letter-spacing.wide}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "label: 14/20 medium, wide tracking",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.14}",
            "lineHeight":    "{font.line-height.20}",
            "fontWeight":    "{font.weight.medium}",
            "letterSpacing": "{font.letter-spacing.wide}"
          }
        }
      },

      "caption": {
        "$description": "Caption text. Timestamps, metadata, image captions, status annotations.",
        "desktop": {
          "$type": "typography",
          "$description": "caption: 12/16 regular, caption tracking",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.12}",
            "lineHeight":    "{font.line-height.16}",
            "fontWeight":    "{font.weight.regular}",
            "letterSpacing": "{font.letter-spacing.caption}"
          }
        },
        "mobile": {
          "$type": "typography",
          "$description": "caption: 12/16 regular, caption tracking",
          "$value": {
            "fontFamily":    "{font.family.primary}",
            "fontSize":      "{font.size.12}",
            "lineHeight":    "{font.line-height.16}",
            "fontWeight":    "{font.weight.regular}",
            "letterSpacing": "{font.letter-spacing.caption}"
          }
        }
      }

    }
  }
}

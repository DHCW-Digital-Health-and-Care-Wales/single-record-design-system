{
  "sr": {
    "icon": {
      "size": {
        "xs": {
          "$type": "dimension",
          "$value": "{icon.size.xs}",
          "$description": "16px — inline icons within dense content"
        },
        "sm": {
          "$type": "dimension",
          "$value": "{icon.size.sm}",
          "$description": "20px — standard inline icons"
        },
        "md": {
          "$type": "dimension",
          "$value": "{icon.size.md}",
          "$description": "24px — default icon size, matching the source grid 1:1"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{icon.size.lg}",
          "$description": "32px — prominent icons, empty states"
        }
      },
      "stroke": {
        "$type": "number",
        "$value": "{icon.stroke}",
        "$description": "1px at every size (DDR-023). There is deliberately no per-size variant."
      },
      "color": {
        "default": {
          "$type": "color",
          "$value": "{sr.color.text.primary}",
          "$description": "Default icon colour — matches primary text"
        },
        "subtle": {
          "$type": "color",
          "$value": "{sr.color.text.secondary}",
          "$description": "Subdued icon — matches secondary text"
        },
        "inverse": {
          "$type": "color",
          "$value": "{sr.color.text.inverse}",
          "$description": "Icon on dark or coloured surfaces"
        },
        "interactive": {
          "$type": "color",
          "$value": "{sr.color.interactive.primary}",
          "$description": "Interactive icon (clickable, hoverable)"
        },
        "critical": {
          "$type": "color",
          "$value": "{sr.color.status.critical}",
          "$description": "Critical / error state icon"
        },
        "warning": {
          "$type": "color",
          "$value": "{sr.color.status.warning}",
          "$description": "Warning state icon"
        },
        "success": {
          "$type": "color",
          "$value": "{sr.color.status.success}",
          "$description": "Success / confirmed state icon"
        },
        "info": {
          "$type": "color",
          "$value": "{sr.color.status.info}",
          "$description": "Informational icon"
        }
      }
    }
  }
}

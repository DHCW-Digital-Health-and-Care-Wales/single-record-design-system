<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WCP mobile: onboarding and dashboard prototype.

    A tap-through of the Figma flow on the Adaptations Mobile page (section
    5443:23238, row "ONBOARDING/DASHBOARD"): splash, login, sign-in, create PIN,
    unlock with PIN, home, profile and the side menu. UI only. There is no
    backend, no database and no real authentication; every number on screen is
    fixed demo content.

    It consumes the design system the way a product does: a reference to the
    DHCW.SingleRecord.Maui library, merged by type in App.xaml, plus the
    library's buildTransitive targets for the brand marks. So it also proves the
    library works for a consumer, which the testbed (linked files) does not.

    Android only, for the same reason as the testbed: it is the route to an
    installable APK for BrowserStack App Live with no signing identity.
  -->

  <PropertyGroup>
    <SrDotnet Condition="'$(SrDotnet)' == ''">net10.0</SrDotnet>
    <TargetFrameworks>$(SrDotnet)-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>WcpPrototype</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>WCP prototype</ApplicationTitle>
    <ApplicationId>wales.nhs.dhcw.singlerecord.wcpprototype</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!-- The design system, as a product consumes it. -->
  <ItemGroup>
    <ProjectReference Include="../../../packages/maui/nuget/DHCW.SingleRecord.Maui.csproj" />
  </ItemGroup>

  <!--
    What a PackageReference would bring in by itself: the brand marks as
    MauiImage (srsymwcpwhite, srsymwcpblue and the rest). A ProjectReference
    does not apply buildTransitive, so it is imported by hand.
  -->
  <Import Project="../../../packages/maui/nuget/buildTransitive/DHCW.SingleRecord.Maui.targets" />

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" ForegroundScale="0.6" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#1b294a" BaseSize="96,96" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="**/*.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:WcpPrototype.Controls"
             x:Class="WcpPrototype.Views.LoginPage"
             Style="{StaticResource AuthPage}">
    <!-- Figma 6432:36606. -->
    <ScrollView x:Name="Scroller">
    <Grid x:Name="Body" RowDefinitions="*,Auto">
        <VerticalStackLayout Grid.Row="0" Spacing="40" Padding="24"
                             VerticalOptions="Center">

            <!-- WCP lockup: the roundel on a white disc, then the bilingual name. -->
            <HorizontalStackLayout Spacing="16" HorizontalOptions="Center"
                                   SemanticProperties.Description="Porth Clinigol Cymru, Welsh Clinical Portal">
                <Border Padding="8" WidthRequest="64" HeightRequest="64" StrokeThickness="0"
                        BackgroundColor="{StaticResource SrColorTextInverse}"
                        VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="32" /></Border.StrokeShape>
                    <Image Source="srsymwcpblue.png" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Porth Clinigol Cymru" StyleClass="HeadingXs,OnNavy" FontSize="20" />
                    <Label Text="Welsh Clinical Portal" StyleClass="HeadingXs,OnNavy" FontSize="20" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- After a forced sign-out (too many wrong PINs). -->
            <c:PinError x:Name="Error" />

            <Button Text="Log in with Microsoft"
                    Style="{StaticResource ButtonOnNavy}"
                    WidthRequest="240" HorizontalOptions="Center"
                    Clicked="OnLogin" />
        </VerticalStackLayout>

        <c:AuthFooter Grid.Row="1" />
    </Grid>
    </ScrollView>
</ContentPage>

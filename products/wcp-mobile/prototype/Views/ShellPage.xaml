<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:WcpPrototype.Controls"
             xmlns:v="clr-namespace:WcpPrototype.Views"
             x:Class="WcpPrototype.Views.ShellPage"
             x:DataType="v:ShellPage">
    <!--
        The signed-in frame shared by Figma 5849:17493 (home), 5880:30076
        (profile information) and 5880:30286 (side menu open): a fixed header,
        a scrolling body, a fixed bottom bar, and the menu drawn over all three.
    -->
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto">

            <!--#region Header ===============================================-->
            <Grid Grid.Row="0" Style="{StaticResource Chrome}" RowDefinitions="Auto,Auto">
                <Grid Padding="8,8,16,8" MinimumHeightRequest="56" ColumnDefinitions="Auto,*,Auto">

                    <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44"
                          SemanticProperties.Description="Open menu">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenMenu" /></Grid.GestureRecognizers>
                        <Path Style="{StaticResource Icon}" Data="{StaticResource SrIconNavMenu}" />
                    </Grid>

                    <Image Grid.Column="1" Source="srsymwcpblue.png"
                           WidthRequest="40" HeightRequest="40" HorizontalOptions="Center"
                           SemanticProperties.Description="Welsh Clinical Portal" />

                    <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                        <Grid WidthRequest="44" HeightRequest="44" SemanticProperties.Description="Notifications">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnNotInPrototype" CommandParameter="Notifications" /></Grid.GestureRecognizers>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource SrIconCommsNotification}" />
                        </Grid>

                        <!-- Avatar. Interactive/Primary with white initials (8.04:1).
                             Opens profile information. -->
                        <Grid WidthRequest="44" HeightRequest="44"
                              SemanticProperties.Description="Your profile, Alys Bevan">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnProfile" /></Grid.GestureRecognizers>
                            <Border Padding="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SrColorInteractivePrimary}, Dark={StaticResource SrColorInteractivePrimaryDark}}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                <Label Text="AB" StyleClass="Bold" TextColor="{StaticResource SrColorTextInverse}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Padding="0" WidthRequest="10" HeightRequest="10"
                                    HorizontalOptions="End" VerticalOptions="End" Margin="0,0,4,4"
                                    BackgroundColor="{StaticResource SrColorStatusSuccess}"
                                    Stroke="{AppThemeBinding Light={StaticResource SrColorSurfaceSectionCards}, Dark={StaticResource SrColorSurfaceSectionCardsDark}}"
                                    StrokeThickness="1.5">
                                <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                            </Border>
                        </Grid>
                    </HorizontalStackLayout>
                </Grid>
                <BoxView Grid.Row="1" StyleClass="Divider" />
            </Grid>
            <!--#endregion-->

            <!--#region Body =================================================-->
            <Grid Grid.Row="1">
                <v:HomeView x:Name="Home" />
                <v:ProfileView x:Name="Profile" IsVisible="False" />
            </Grid>
            <!--#endregion-->

            <!--#region Bottom bar ===========================================-->
            <Grid Grid.Row="2" Style="{StaticResource Chrome}" RowDefinitions="Auto,Auto">
                <BoxView Grid.Row="0" StyleClass="Divider" />
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*">
                    <c:NavTab Grid.Column="0" Index="0" Text="Home"
                              IconData="{StaticResource SrIconNavHome}"
                              SelectedIndex="0" Command="{Binding TabCommand}" />
                    <c:NavTab Grid.Column="1" Index="1" Text="Watchlist"
                              IconData="{StaticResource SrIconActionWatchlist}"
                              SelectedIndex="0" Command="{Binding TabCommand}" />

                    <!-- Search: the raised circle. Puts the cursor in the NHS number field. -->
                    <Border Grid.Column="2" Padding="0" WidthRequest="56" HeightRequest="56"
                            TranslationY="-12" StrokeThickness="0" HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SrColorInteractiveLink}, Dark={StaticResource SrColorInteractivePrimaryDark}}"
                            SemanticProperties.Description="Search for a patient">
                        <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSearch" /></Border.GestureRecognizers>
                        <Path Style="{StaticResource Icon}" Data="{StaticResource SrIconNavSearch}"
                              WidthRequest="28" HeightRequest="28" StrokeThickness="1.5"
                              Stroke="{StaticResource SrColorTextInverse}" />
                    </Border>

                    <c:NavTab Grid.Column="3" Index="3" Text="Patients"
                              IconData="{StaticResource SrIconPeoplePatient}"
                              SelectedIndex="0" Command="{Binding TabCommand}" />
                    <c:NavTab Grid.Column="4" Index="4" Text="More"
                              IconData="{StaticResource SrIconNavMoreHorizontal}"
                              SelectedIndex="0" Command="{Binding TabCommand}" />
                </Grid>
            </Grid>
            <!--#endregion-->
        </Grid>

        <!--#region Side menu (Figma 5880:30286) =============================-->
        <Grid x:Name="Menu" IsVisible="False">
            <BoxView x:Name="Scrim" Color="{StaticResource ColorNavy900}" Opacity="0">
                <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMenu" /></BoxView.GestureRecognizers>
            </BoxView>

            <Grid x:Name="Panel" WidthRequest="300" HorizontalOptions="Start" TranslationX="-300"
                  Style="{StaticResource Chrome}"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">

                <Grid Grid.Row="0" Padding="16,20,8,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Image Source="srsymwcpblue.png" WidthRequest="40" HeightRequest="40" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Porth Clinigol Cymru" StyleClass="Muted" />
                        <Label Text="Welsh Clinical Portal" StyleClass="Muted" />
                    </VerticalStackLayout>
                    <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44"
                          SemanticProperties.Description="Close menu">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMenu" /></Grid.GestureRecognizers>
                        <Path Style="{StaticResource IconSecondary}" Data="{StaticResource SrIconNavChevronLeft}" />
                    </Grid>
                </Grid>
                <BoxView Grid.Row="1" StyleClass="Divider" />

                <VerticalStackLayout Grid.Row="2" Padding="20,16" Spacing="4">
                    <Label Text="BEVAN, Alys" StyleClass="HeadingXs,Bold" />
                    <Label Text="Specialty doctor" StyleClass="Muted" />
                </VerticalStackLayout>
                <BoxView Grid.Row="3" StyleClass="Divider" />

                <VerticalStackLayout Grid.Row="4" Padding="20,16" Spacing="4">
                    <Label Text="Current issuing authority" StyleClass="HeadingXs,Bold" />
                    <Label Text="Swansea Bay University Health Board" StyleClass="Muted" />
                </VerticalStackLayout>
                <BoxView Grid.Row="5" StyleClass="Divider" />

                <VerticalStackLayout Grid.Row="6" Padding="8,12" Spacing="4">
                    <!-- Current page: Surface/Accent and Text/Selected, and
                         announced as current, not shown by colour alone. -->
                    <Border StrokeThickness="0" Padding="12,0" MinimumHeightRequest="44"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SrColorSurfaceAccent}, Dark={StaticResource SrColorSurfaceAccentDark}}"
                            SemanticProperties.Description="Home, current page">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuHome" /></Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Path Style="{StaticResource IconSm}" Data="{StaticResource SrIconNavHome}"
                                  Stroke="{AppThemeBinding Light={StaticResource SrColorTextSelected}, Dark={StaticResource SrColorTextSelectedDark}}" />
                            <Label Text="Home" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource SrColorTextSelected}, Dark={StaticResource SrColorTextSelectedDark}}" />
                        </HorizontalStackLayout>
                    </Border>
                    <HorizontalStackLayout Spacing="12" Padding="12,0" MinimumHeightRequest="44">
                        <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnNotInPrototype" CommandParameter="Infection control" /></HorizontalStackLayout.GestureRecognizers>
                        <Path Style="{StaticResource IconSecondary}" Data="{StaticResource SrIconStatusInfo}" />
                        <Label Text="Infection control" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="12" Padding="12,0" MinimumHeightRequest="44">
                        <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnNotInPrototype" CommandParameter="Call support" /></HorizontalStackLayout.GestureRecognizers>
                        <Path Style="{StaticResource IconSecondary}" Data="{StaticResource SrIconCommsPhone}" />
                        <Label Text="Call support" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="12" Padding="12,0" MinimumHeightRequest="44">
                        <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnNotInPrototype" CommandParameter="Settings" /></HorizontalStackLayout.GestureRecognizers>
                        <Path Style="{StaticResource IconSecondary}" Data="{StaticResource SrIconNavSettings}" />
                        <Label Text="Settings" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <BoxView Grid.Row="7" StyleClass="Divider" />
                <!-- Log out. Figma draws it red; red is kept for loss of data
                     (Styles.xaml), so it is plain text with its icon here. -->
                <HorizontalStackLayout Grid.Row="8" Spacing="12" Padding="20,0" MinimumHeightRequest="52">
                    <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnLogOut" /></HorizontalStackLayout.GestureRecognizers>
                    <Path Style="{StaticResource IconSm}" Data="{StaticResource SrIconNavLogOut}" />
                    <Label Text="Log out" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <BoxView Grid.Row="9" StyleClass="Divider" />
                <Label Grid.Row="10" Text="Version 0.1.0.1112" StyleClass="Caption,Centred" Margin="0,12,0,16" />
            </Grid>
        </Grid>
        <!--#endregion-->
    </Grid>
</ContentPage>

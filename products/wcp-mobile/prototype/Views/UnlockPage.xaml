<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:WcpPrototype.Controls"
             x:Class="WcpPrototype.Views.UnlockPage"
             Style="{StaticResource AuthPage}">
    <!-- Figma 6432:36863. -->
    <ScrollView x:Name="Scroller">
    <Grid x:Name="Body" RowDefinitions="*,Auto">
            <VerticalStackLayout Grid.Row="0" Padding="16,24,16,16" Spacing="16" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Image Source="srsymwcpwhite.png" WidthRequest="56" HeightRequest="56"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="Welsh Clinical Portal" />
                    <Label Text="Welcome back" StyleClass="HeadingM,OnNavy,Centred"
                           SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>

                <Border Style="{StaticResource GlassCard}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Enter your PIN to open WCP mobile" StyleClass="OnNavy,Centred" />
                        <c:PinDots x:Name="Dots" />
                        <c:PinError x:Name="Error" />

                        <c:PinPad x:Name="Pad" Margin="0,4,0,0" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="Log out"
                                    Style="{StaticResource ButtonOutlineOnNavy}"
                                    FontSize="16" MinimumHeightRequest="48"
                                    Clicked="OnLogOut" />
                            <Button Grid.Column="1" Text="Biometric login"
                                    BackgroundColor="{StaticResource SrColorInteractiveLink}"
                                    FontSize="16" MinimumHeightRequest="48"
                                    Clicked="OnBiometric" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        <c:AuthFooter Grid.Row="1" />
    </Grid>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:WcpPrototype.Controls"
             x:Class="WcpPrototype.Views.UnlockPage"
             Style="{StaticResource AuthPage}">
    <!-- Figma 6432:36863. -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,40,16,24" Spacing="24" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Image Source="srsymwcpwhite.png" WidthRequest="64" HeightRequest="64"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="Welsh Clinical Portal" />
                    <Label Text="Welcome back" StyleClass="HeadingM,OnNavy,Centred"
                           SemanticProperties.HeadingLevel="Level1" />
                </VerticalStackLayout>

                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Enter your PIN to open WCP mobile" StyleClass="OnNavy,Centred" />
                        <c:PinDots x:Name="Dots" />
                        <Label x:Name="Message" IsVisible="False" StyleClass="OnNavy,Centred,Bold" />

                        <c:PinPad x:Name="Pad" Margin="0,8,0,0" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="Log out"
                                    Style="{StaticResource ButtonOutlineOnNavy}"
                                    FontSize="16" MinimumHeightRequest="48"
                                    Clicked="OnLogOut" />
                            <Button Grid.Column="1" Text="Biometric login"
                                    BackgroundColor="{StaticResource SrColorInteractiveLink}"
                                    FontSize="16" MinimumHeightRequest="48"
                                    Clicked="OnBiometric" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <c:AuthFooter Grid.Row="1" />
    </Grid>
</ContentPage>

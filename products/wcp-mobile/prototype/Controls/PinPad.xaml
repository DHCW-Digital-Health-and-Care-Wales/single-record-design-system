<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WcpPrototype.Controls.PinPad">
    <!--
        The on-screen keypad from Patterns/Sign in: 1 to 9, then Clear, 0 and
        backspace. Keys are 98 x 40 in the frame; here they share the width in
        thirds and keep a 44px minimum height, which is the touch target floor.
    -->
    <Grid x:Name="Keys"
          ColumnDefinitions="*,*,*"
          RowDefinitions="Auto,Auto,Auto,Auto"
          ColumnSpacing="8" RowSpacing="8" />
</ContentView>
